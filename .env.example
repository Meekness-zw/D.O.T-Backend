# ==============================
# Supabase Configuration
# ==============================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ==============================
# Dexatel (send OTP codes via SMS)
# ==============================
# Get your API key from: https://app.dexatel.com → Settings → API
# DEXATEL_SENDER is the alphanumeric sender name shown to recipients.
# Register and get your sender name approved in the Dexatel dashboard first.

DEXATEL_API_KEY=your_dexatel_api_key
DEXATEL_SENDER=DOT

# Resend sends signup verification and password-reset emails.
# RESEND_FROM_EMAIL must be on a domain verified in your Resend account.
# The inbox shows "Delivery On Time" even if you only set the address.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@deliveryontime.co.zw

# SMS spend/rate limits. These count only messages accepted by Dexatel.
# IP limits are intentionally loose: mobile carriers (this app's real traffic)
# commonly put thousands of distinct customers behind one shared carrier-grade
# NAT IP, so a tight per-IP cap blocks unrelated real signups, not abusers.
# Per-phone and global-per-day are the real abuse guard.
SMS_MAX_PER_PHONE_HOUR=3
SMS_MAX_PER_PHONE_DAY=8
SMS_MAX_PER_IP_HOUR=60
SMS_MAX_PER_IP_DAY=300
SMS_MAX_PHONES_PER_IP_DAY=150
SMS_MAX_GLOBAL_DAY=400
# Stricter per-process ceiling while the durable Supabase counter is offline.
SMS_MAX_FALLBACK_GLOBAL_DAY=50
# Optional comma-separated E.164 prefixes. Blank allows every country.
# SMS_ALLOWED_COUNTRY_PREFIXES=+263,+27

# ==============================
# Pesepay Payment Gateway
# ==============================
# Pesepay is one of two customer checkout gates. The other is ZB Smile Cash
# (Smile & Pay), below. Both are COLLECTIONS-ONLY (customer payment-in via a
# hosted redirect). Neither pays merchants or couriers out — earnings stay in
# the in-app wallet for manual cashout.
#
# Preferred gate for customer charges and payouts. smilepay (ZB, the default)
# is tried first. Pesepay is the automatic backup when Smile Cash has no keys
# or its call fails. Set pesepay here only to make Pesepay the preferred gate.
# CHECKOUT_PAYMENT_GATEWAY=smilepay
# Flip the preferred gate live, without restarting and without a new app build:
#   curl -X PUT https://<API>/admin/payments/gateway \
#     -H "x-admin-key: $ADMIN_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"gateway":"smilepay"}'
#
# Get your Integration Key + Encryption Key from https://dashboard.pesepay.com
# (Settings → Integrations). Use the SANDBOX key pair for testing and swap in
# the LIVE key pair for production. Apply to backend/.env and restart the server.
PAYMENT_INTEGRATION_ID=your_pesepay_integration_key
PAYMENT_ENCRYPTION_KEY=your_pesepay_encryption_key
#
# Environment. Leave unset for production (https://api.pesepay.com/api/payments-engine/).
# Set PESEPAY_ENV=sandbox to use the sandbox host with your sandbox key pair
# (https://api.test.sandbox.pesepay.com/payments-engine/ — note: no /api prefix).
# PESEPAY_ENV=sandbox
# Or override the full base URL directly:
# PESEPAY_BASE_URL=https://api.test.sandbox.pesepay.com/payments-engine/

# ==============================
# ZB Smile Cash (Smile & Pay)
# ==============================
# Second checkout gate. Leave the keys blank until ZB issues them, then set
# CHECKOUT_PAYMENT_GATEWAY=smilepay (or PUT /admin/payments/gateway) to send
# new checkouts here. Keys come from the merchant portal:
#   sandbox:    https://zbnet.zb.co.zw/wallet_sandbox_merchant/
#   production: Settings → API Keys on the live Smile & Pay portal
# SMILEPAY_ENV=sandbox uses the sandbox host. Set SMILEPAY_ENV=production
# with the live key pair when you go live.
SMILEPAY_ENV=sandbox
SMILEPAY_API_KEY=
SMILEPAY_API_SECRET=
# SMILEPAY_BASE_URL=

# Every merchant price is served to customers marked up by this much (default 0.15 = 15%).
# The markup stays with DOT; the merchant is credited their own base price. See orderPaymentSplit.js.
PLATFORM_MARKUP_RATE=0.15

# DOT's further cut of the merchant's post-markup earnings on every order (default 0.05 = 5%,
# max 0.5). Applied the moment the order is paid (computeSubtotalSplit), so a merchant's wallet
# balance is already net of both this and the markup above — nothing is deducted again later.
WEEKLY_COMMISSION_RATE=0.05

# Platform's cut of every delivery fee (default 0.2 = 20% — couriers keep the other 80%).
DELIVERY_PLATFORM_CUT_RATE=0.2
# Delivery platform/service fee withheld from courier pool (“OTD”; shown in courier apps).
OTD_PLATFORM_SERVICE_CHARGE_USD=0.99

# Public HTTPS base URL of this API (used in mobile app for resultUrl / returnUrl). Examples: ngrok, Render, Railway, Fly.io
PUBLIC_API_BASE_URL=

# Must match app.config.js scheme (default dotdeliveryontime)
APP_PAYMENT_DEEP_LINK_SCHEME=dotdeliveryontime

# ==============================
# Help & support (merchant app — GET /merchant/help)
# ==============================

# ==============================
# Google Maps (address autocomplete / reverse geocoding proxy)
# ==============================
# Create a key at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

SUPPORT_PHONE=+263771234567
SUPPORT_EMAIL=support@example.com
# Optional: WhatsApp chat link, e.g. https://wa.me/263771234567
SUPPORT_WHATSAPP_URL=
SUPPORT_HOURS=Mon–Fri 8:00–18:00

# ==============================
# Server Configuration
# ==============================

PORT=4000
NODE_ENV=development

# ==============================
# CORS (comma-separated)
# ==============================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ==============================
# Admin Dashboard API keys
# ==============================
# Each key logs into the SAME dashboard app (D.O.T-Dashboard) but scopes what
# that account can see/do — see DASHBOARD_SECTIONS / dashboardRoleCanAccess in
# server.js. Leave accountant/sales_marketing blank to disable that login.

ADMIN_API_KEY=your_admin_api_key
ACCOUNTANT_API_KEY=your_accountant_api_key
SALES_MARKETING_API_KEY=your_sales_marketing_api_key

# Public URL of the admin dashboard frontend — used to redirect back here
# after the QuickBooks OAuth consent screen.
ADMIN_DASHBOARD_URL=http://localhost:5174

# ==============================
# QuickBooks Online integration
# ==============================
# Create an app at https://developer.intuit.com to get a Client ID/Secret.
# Start with sandbox credentials + QUICKBOOKS_ENVIRONMENT=sandbox to test
# safely, then switch to production keys when ready to go live.
# QUICKBOOKS_REDIRECT_URI must exactly match the Redirect URI configured on
# the Intuit app, and point at this backend: <PUBLIC_API_BASE_URL>/admin/quickbooks/callback
# QUICKBOOKS_TOKEN_ENCRYPTION_KEY must be a 32-byte key, base64 or hex —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# QUICKBOOKS_STATE_SECRET can reuse SUPABASE_JWT_SECRET if unset.

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:4000/admin/quickbooks/callback
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
QUICKBOOKS_STATE_SECRET=

# ==============================
# Anthropic Claude API (AI store categorization)
# ==============================
# Get a key at https://platform.claude.com → API Keys.
# Powers POST /business-types/suggest (auto-categorize stores during merchant onboarding).

ANTHROPIC_API_KEY=your_anthropic_api_key
